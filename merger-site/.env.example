# انسخ إلى .env — وضَع نفس القيم في Vercel → Settings → Environment Variables
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# حدود قابلة للضبط (اختياري — هذه القيم الافتراضية)
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
# تجاوز مسار ffmpeg/ffprobe إن لزم (افتراضيًا ffmpeg-static ثم مسار النظام)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
